{
  "name": "lista-tarefas-artrock",
  "version": "1.1.0",
  "description": "ArtRock — Sistema de Gestão de Tarefas",
  "author": "ArtRock",
  "homepage": "https://github.com/FelipeMoraisOC/lista-tarefas-artrock",
  "main": "main.js",
  "scripts": {
    "start": "vite build --config vite.config.js && electron .",
    "dev": "concurrently \"vite --config vite.config.js\" \"electron . --dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "vite build --config vite.config.js",
    "dist": "vite build --config vite.config.js && electron-builder --win",
    "dist:publish": "vite build --config vite.config.js && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.artrock.tarefas",
    "productName": "ArtRock Tarefas",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "dist-renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "ArtRock Tarefas"
    },
    "publish": {
      "provider": "github",
      "owner": "FelipeMoraisOC",
      "repo": "lista-tarefas-artrock"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "firebase-admin": "^14.5.0",
    "jsdom": "^30.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "electron@28.3.3": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "firebase": "^12.19.0"
  }
}
