{
  "name": "lista-tarefas-artrock",
  "version": "1.0.0",
  "description": "ArtRock — Sistema de Gestão de Tarefas",
  "main": "main.js",
  "scripts": {
    "start": "vite build --config vite.config.js && electron .",
    "dev": "concurrently \"vite --config vite.config.js\" \"electron . --dev\"",
    "build": "vite build --config vite.config.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^28.0.0",
    "firebase-admin": "^14.5.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "electron@28.3.3": true
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
